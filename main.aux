\@writefile{lof}{\contentsline {figure}{\numberline {2.21}{\ignorespaces Lemma~\ref {lem_2_benson}. Left: $I_1$ possesses an \textcolor {sealred}{eye} at $A1$ and shares a \textcolor {bg}{joiner} at $D1$ with $I_2$, which has an external liberty at $F1$ (\textcolor {Moss}{green}). Right: White must first occupy $F1$ and play at $D1$ to capture $I_2$ before $I_1$ can be threatened.}}{38}{figure.caption.40}\protected@file@percent }
