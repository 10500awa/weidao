\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Connection between stones. The black stones at $B5$ and $C5$ (\textcolor {Moss}{green}) satisfy $C(i_1) = C(i_2)$ and $P(i_1) \sim P(i_2)$, so they are connected ($i_1 \leftrightarrow i_2$). By contrast, the stones at $B2$ and $C2$ (\textcolor {sealred}{red}) are adjacent in position but differ in state ($C(i_1) \neq C(i_2)$), whereas the white stones at $E4$ and $F5$ (\textcolor {terracotta}{orange}) share the same state but lie on diagonal intersections ($P(i_1) \not  \sim P(i_2)$); neither pair is connected.}}{14}{figure.caption.16}\protected@file@percent }
\newlabel{fig:def_connection}{{2.2}{14}{Connection between stones. The black stones at $B5$ and $C5$ (\textcolor {Moss}{green}) satisfy $C(i_1) = C(i_2)$ and $P(i_1) \sim P(i_2)$, so they are connected ($i_1 \leftrightarrow i_2$). By contrast, the stones at $B2$ and $C2$ (\textcolor {sealred}{red}) are adjacent in position but differ in state ($C(i_1) \neq C(i_2)$), whereas the white stones at $E4$ and $F5$ (\textcolor {terracotta}{orange}) share the same state but lie on diagonal intersections ($P(i_1) \not \sim P(i_2)$); neither pair is connected}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Equivalence classes in $T / {\equiv }$. Left: The family $I^1$ consists of an isolated black stone at $B6$ (\textcolor {terracotta}{orange}) and a four-stone black group (\textcolor {Moss}{green}, where $B2 \equiv D3$ via the chain $B2 \leftrightarrow C2 \leftrightarrow D2 \leftrightarrow D3$), while $I^2$ consists of two distinct white groups (\textcolor {bg}{blue} and \textcolor {amethyst}{purple}). Right: The vacant intersections are partitioned into three regions in $I^0$: the lower-left region $R_1$ (\textcolor {sealred}{red}), the upper-right region $R_2$ (\textcolor {teal}{teal}), and the remaining unmarked vacant region.}}{15}{figure.caption.17}\protected@file@percent }
\newlabel{fig:def_groups_regions}{{2.3}{15}{Equivalence classes in $T / {\equiv }$. Left: The family $I^1$ consists of an isolated black stone at $B6$ (\textcolor {terracotta}{orange}) and a four-stone black group (\textcolor {Moss}{green}, where $B2 \equiv D3$ via the chain $B2 \leftrightarrow C2 \leftrightarrow D2 \leftrightarrow D3$), while $I^2$ consists of two distinct white groups (\textcolor {bg}{blue} and \textcolor {amethyst}{purple}). Right: The vacant intersections are partitioned into three regions in $I^0$: the lower-left region $R_1$ (\textcolor {sealred}{red}), the upper-right region $R_2$ (\textcolor {teal}{teal}), and the remaining unmarked vacant region}{figure.caption.17}{}}
