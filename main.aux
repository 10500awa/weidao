\@writefile{lof}{\contentsline {figure}{\numberline {2.20}{\ignorespaces Lemma~\ref {lem_1_benson}. Left: A black group $I$ with two distinct eyes, $O_1$ (\textcolor {sealred}{red}) and $O_2$ (\textcolor {terracotta}{orange}). Right: After White occupies $C1$ and $D1$, playing at the last vacant intersection $E1$ (\textcolor {teal}{teal}) is illegal by suicide since $I$ retains a liberty at $A1$.}}{37}{figure.caption.39}\protected@file@percent }
\newlabel{fig:lem_1_benson}{{2.20}{37}{Lemma~\ref {lem_1_benson}. Left: A black group $I$ with two distinct eyes, $O_1$ (\textcolor {sealred}{red}) and $O_2$ (\textcolor {terracotta}{orange}). Right: After White occupies $C1$ and $D1$, playing at the last vacant intersection $E1$ (\textcolor {teal}{teal}) is illegal by suicide since $I$ retains a liberty at $A1$}{figure.caption.39}{}}
